{
  "manifest_version": 3,
  "name": "Web2MD — Page to Markdown",
  "version": "0.2.0",
  "description": "Convert any web page to clean, AI-ready Markdown with one click.",
  "permissions": ["activeTab", "clipboardWrite", "storage", "scripting", "downloads", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
