{
  "manifest_version": 3,
  "name": "Web2MD — Page to Markdown",
  "version": "0.1.0",
  "description": "Convert any web page to clean, AI-ready Markdown with one click.",
  "permissions": ["activeTab", "clipboardWrite", "contextMenus", "storage", "scripting", "downloads"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
