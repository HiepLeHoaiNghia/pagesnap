{
  "manifest_version": 3,
  "name": "PageSnap — Web to Markdown & HTML Snapshot",
  "version": "1.1.0",
  "description": "Convert web pages to clean, AI-ready Markdown and standalone offline HTML snapshots with one click.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "storage",
    "scripting",
    "downloads",
    "contextMenus"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
